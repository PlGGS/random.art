{
  "tasks": {
    "build": "NODE_ENV=production react-router build",
    "dev": "deno task build && deno run -A --env --unstable-kv --watch=app,server.development.ts server.development.ts",
    "format": "deno fmt",
    "lint": "deno lint",
    "start": "deno run -A --env --unstable-kv ./server.production.ts",
    "typecheck": {
      "command": "deno check --node-modules-dir=auto '**/*'",
      "dependencies": ["typegen"]
    },
    "typegen": "react-router typegen"
  },
  "compilerOptions": {
    "lib": ["deno.window", "dom"],
    "jsx": "react-jsx",
    "jsxImportSource": "react",
    "jsxImportSourceTypes": "@types/react",
    "rootDirs": [".", "./.react-router/types"],
    "types": ["vite/client"]
  },
  "unstable": ["sloppy-imports"],
  "exclude": ["build/"],
  "nodeModulesDir": "manual",
  "imports": {
    "~/": "./app/",
    "@std/http": "jsr:@std/http@^1.0.25",
    "@std/path": "jsr:@std/path@^1.1.4",
    "@std/encoding": "jsr:@std/encoding@1.0.10",
    "@std/crypto/crypto": "jsr:@std/crypto@1.0.5/crypto",
    "react": "npm:react@^19.2.4",
    "react-dom": "npm:react-dom@^19.2.4",
    "react-router": "npm:react-router@^7.13.1",
    "react-router-dom": "npm:react-router-dom@^7.13.1",
    "kv_oauth": "https://deno.land/x/deno_kv_oauth@v0.10.0/mod.ts"
  }
}
